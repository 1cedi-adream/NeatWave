NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://user:password@host/neatwave?sslmode=require
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000/api/v1
SOCKET_ALLOWED_ORIGINS=http://localhost:5174
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=NeatWave
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NeatWave <no-reply@example.com>
WORKER_POLL_MS=5000
SUPERADMIN_NAME=NeatWave Developer
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
